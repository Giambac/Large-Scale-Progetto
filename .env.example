# Copy this file to .env and fill in the key(s) you have.
# The system checks in this order and uses the FIRST key it finds:
#   1. ANTHROPIC_API_KEY  (Claude — preferred)
#   2. OPENAI_API_KEY     (GPT)
#   3. GOOGLE_API_KEY     (Gemini / Google AI Studio)
# Leave unused keys blank or remove them entirely.

ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GOOGLE_API_KEY=
